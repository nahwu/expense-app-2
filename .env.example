# Runtime
# For local dev use development; for production use production.
NODE_ENV=development
PORT=3000

# Local dev DB path (Docker bind mount). For DS920+, use a NAS path like /volume1/docker/expense-app/db
DB_DATA_PATH=./.docker/postgres

# PostgreSQL
POSTGRES_DB=expense_app
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=replace_with_strong_password
# Local dev (npm run dev on host machine):
DATABASE_URL=postgresql://expense_user:replace_with_strong_password@localhost:5432/expense_app

# Auth.js
# Local dev:
NEXTAUTH_URL=http://localhost:3000
# Production example:
# NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace_with_long_random_secret
