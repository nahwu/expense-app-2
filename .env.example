# ClearWorth local development environment template
# Copy to .env and replace placeholder secrets before running.

NODE_ENV=development
PORT=3000

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=clearworth
POSTGRES_USER=clearworth
POSTGRES_PASSWORD=change_me
DB_DATA_PATH=./.docker/postgres

# App database connection string (used by Next.js runtime)
DATABASE_URL=postgresql://clearworth:change_me@localhost:5432/clearworth

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
# Optional internal URL for reverse-proxy/container topologies
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
