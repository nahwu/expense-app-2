# Runtime
NODE_ENV=production
PORT=3000

# DS920+ bind mount (adjust if your path differs)
DB_DATA_PATH=/volume1/docker/expense-app/db

# PostgreSQL
POSTGRES_DB=expense_app
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql://expense_user:replace_with_strong_password@db:5432/expense_app

# Auth.js
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace_with_long_random_secret

# Bootstrap admin user (used by Credentials provider scaffold)
BOOTSTRAP_USER_ID=00000000-0000-0000-0000-000000000001
BOOTSTRAP_USER_EMAIL=admin@example.com
BOOTSTRAP_USER_PASSWORD=replace_with_strong_password
# Optional: use hash instead of plain password; leave password blank if this is set
BOOTSTRAP_USER_PASSWORD_HASH=

